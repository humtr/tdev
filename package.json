{
  "name": "@humtr/tdev",
  "private": true,
  "type": "module",
  "exports": "./src/index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "syntax": "for file in src/*.mjs test/*.mjs bench/*.mjs; do node --check \"$file\"; done",
    "test": "node --test test/*.test.mjs",
    "demo": "node src/cli.mjs demo",
    "durable-demo": "node src/cli.mjs durable-demo",
    "check": "npm run syntax && npm test && npm run demo --silent && npm run durable-demo --silent",
    "bench": "node bench/control-plane.mjs",
    "bench:persistence": "node bench/persistence-hot-path.mjs",
    "bench:compare": "node bench/compare-development-states.mjs"
  }
}

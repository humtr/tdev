{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "principals",
    "repositories"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "principals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tokenHash",
          "repos"
        ],
        "properties": {
          "tokenHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repos": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^refs/heads/[A-Za-z0-9_./-]+$"
              }
            }
          },
          "managedRefNamespaces": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^refs/heads/[A-Za-z0-9_./-]+/$"
              }
            }
          },
          "projectPolicies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          "defaultRepo": {
            "type": "string"
          },
          "deploymentTargets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "diagnostics": {
            "type": "boolean",
            "default": false,
            "description": "May activate or stop runtime-wide diagnostic capture; inspection and acknowledgment remain principal-scoped."
          }
        },
        "additionalProperties": false
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "remote",
          "identity",
          "refs",
          "validation"
        ],
        "properties": {
          "kind": {
            "enum": [
              "local",
              "github"
            ]
          },
          "remote": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^refs/heads/[A-Za-z0-9_./-]+$"
            }
          },
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "networks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "host",
                "none",
                "internet"
              ]
            }
          },
          "executor": {
            "description": "Omitted means Termux-native same-UID execution. SSH/OCI is an explicit optional backend, never an installation prerequisite.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "native"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "target",
                  "script",
                  "digest",
                  "spool",
                  "image",
                  "knownHosts",
                  "identityFile"
                ],
                "properties": {
                  "kind": {
                    "const": "ssh"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "python": {
                    "type": "string",
                    "minLength": 1
                  },
                  "script": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "spool": {
                    "type": "string",
                    "minLength": 1
                  },
                  "image": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_./:-]+@sha256:[0-9a-f]{64}$"
                  },
                  "knownHosts": {
                    "type": "string",
                    "minLength": 1
                  },
                  "identityFile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "networkPolicyDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "toolingEnvironment": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "allOf": [
                {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                {
                  "not": {
                    "enum": [
                      "HOME",
                      "TMPDIR",
                      "XDG_CONFIG_HOME",
                      "XDG_CACHE_HOME",
                      "GIT_CONFIG_GLOBAL",
                      "GIT_CONFIG_SYSTEM",
                      "SSH_AUTH_SOCK",
                      "TDEV_ENV_DIR"
                    ]
                  }
                }
              ]
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "managedRefNamespaces": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^refs/heads/[A-Za-z0-9_./-]+/$"
            }
          },
          "defaultRef": {
            "type": "string",
            "pattern": "^refs/heads/[A-Za-z0-9_./-]+$"
          },
          "managedOnly": {
            "type": "boolean"
          },
          "allowWorktree": {
            "type": "boolean"
          },
          "checkout": {
            "type": "string",
            "minLength": 1
          },
          "checkoutIdentity": {
            "type": "string",
            "pattern": "^local:[0-9]+:[0-9]+$"
          },
          "artifactValidation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$",
            "description": "Adopted command for later sealed-artifact verification. Defaults to validation, executed against the artifact layout. Recipes cannot replace this policy. Not executed by inspectRecipe."
          }
        },
        "additionalProperties": false,
        "dependentRequired": {
          "checkout": [
            "checkoutIdentity"
          ],
          "checkoutIdentity": [
            "checkout"
          ]
        }
      }
    },
    "projectPolicies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "validation": {
            "type": "string",
            "minLength": 1
          },
          "executor": {
            "description": "Omitted means Termux-native same-UID execution. SSH/OCI is an explicit optional backend, never an installation prerequisite.",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "native"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "target",
                  "script",
                  "digest",
                  "spool",
                  "image",
                  "knownHosts",
                  "identityFile"
                ],
                "properties": {
                  "kind": {
                    "const": "ssh"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "python": {
                    "type": "string",
                    "minLength": 1
                  },
                  "script": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "spool": {
                    "type": "string",
                    "minLength": 1
                  },
                  "image": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_./:-]+@sha256:[0-9a-f]{64}$"
                  },
                  "knownHosts": {
                    "type": "string",
                    "minLength": 1
                  },
                  "identityFile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "networkPolicyDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "toolingEnvironment": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "allOf": [
                {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                {
                  "not": {
                    "enum": [
                      "HOME",
                      "TMPDIR",
                      "XDG_CONFIG_HOME",
                      "XDG_CACHE_HOME",
                      "GIT_CONFIG_GLOBAL",
                      "GIT_CONFIG_SYSTEM",
                      "SSH_AUTH_SOCK",
                      "TDEV_ENV_DIR"
                    ]
                  }
                }
              ]
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "networks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "host",
                "none",
                "internet"
              ]
            }
          },
          "kind": {
            "enum": [
              "local",
              "github"
            ]
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "allowCreate": {
            "type": "boolean"
          },
          "managedRefNamespace": {
            "type": "string",
            "pattern": "^refs/heads/[A-Za-z0-9_./-]+/$"
          },
          "artifactValidation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$",
            "description": "Adopted command for later sealed-artifact verification. Defaults to validation, executed against the artifact layout. Recipes cannot replace this policy. Not executed by inspectRecipe."
          }
        },
        "required": [
          "kind",
          "validation",
          "managedRefNamespace"
        ],
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "local"
              }
            },
            "required": [
              "root"
            ],
            "not": {
              "required": [
                "owner"
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "github"
              }
            },
            "required": [
              "owner"
            ],
            "not": {
              "required": [
                "root"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "deploymentTargets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "termux"
          },
          "servicePrefix": {
            "type": "string",
            "pattern": "^tdev-app-[a-z0-9-]*$",
            "maxLength": 40
          }
        },
        "required": [
          "kind",
          "servicePrefix"
        ],
        "additionalProperties": false
      }
    },
    "artifactLimits": {
      "type": "object",
      "properties": {
        "outputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "inputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "workingBytes": {
          "description": "Native per-operation working-storage and child file-size budget. Applies to ordinary exec (command/process), source validation and artifact execution. Frozen in the accepted payload; later config changes affect only new operations. Default 134217728. Separate source capture and task dependency limits still apply.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "retainedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736
        },
        "retentionSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "watch"
          ],
          "default": "off"
        },
        "traceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 120
        },
        "slowSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "default": 30
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 300
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-stateVersions": [
    3,
    4,
    5
  ]
}

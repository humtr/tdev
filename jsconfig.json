{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.mjs",
    "tools/**/*.mjs",
    "test/fixtures/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".artifacts"
  ]
}
